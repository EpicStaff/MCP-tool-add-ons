# Required — VNC password for browser_use_with_cua. No default; the service will
# refuse to start (docker-compose and container entrypoint both fail closed) if unset.
VNC_PASS=

# Required — the browser runner uses ChatOpenAI(model="o3").
OPENAI_API_KEY=

# Required today — checked at import by app_browser_use/browser_runner.py
# even though the DeepSeek LLM path is commented out.
DEEPSEEK_API_KEY=

# Optional — compose defaults shown.
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_TEMPERATURE=0.0
# VNC_GEOMETRY=1600x900   (hardcoded in docker-compose.yml; .env has no effect)
